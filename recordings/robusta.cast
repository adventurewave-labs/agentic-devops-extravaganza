[3.356, "o", "===================================================================\n\ud83e\udde0 Step 2: Sending alert + context to GLM-4.5 for root-cause analysis\n==============================================================="]
[3.368, "o", "=================\n\nPrompt sent to LLM:\n--------------------------------------------------------------------------------\n  You are an autonomous SRE agent (Robusta) investigating a Prometheus alert.\n  "]
[3.38, "o", "\n  ALERT: PaymentAPIHighErrorRate\n  SEVERITY: critical\n  NAMESPACE: payment-prod\n  SERVICE: payment-api\n  POD: payment-api-7c4f5b-x9qkl\n  STARTED: 2026-08-20T03:42:00Z\n  \n  SUMMARY: Payment API error "]
