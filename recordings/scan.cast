{"version": 2, "width": 100, "height": 30, "timestamp": 1787347152, "title": "k8sgpt finds the broken resources \u2014 no LLM", "env": {"SHELL": "/bin/bash", "TERM": "xterm-256color"}}
[0.007963, "o", "\u001b[2m# a deliberately broken payment-prod cluster, served over the real Kubernetes API\u001b[0m\r\n\u001b[1;36m$ kubectl --insecure-skip-tls-verify -n payment-prod get pods\u001b[0m\r\n"]
[0.068892, "o", "NAME                          AGE\r\npayment-api-7c4f5b-x9qkl      41h\r\npayment-worker-6d8b2c-p3mnr   41h\r\n"]
[0.070977, "o", "\r\n"]
[0.071022, "o", "\u001b[1;36m$ kubectl --insecure-skip-tls-verify get nodes\u001b[0m\r\n"]
[0.135856, "o", "NAME       AGE\r\nworker-1   6d13h\r\nworker-3   6d13h\r\n"]
[0.137984, "o", "\r\n"]
[0.138025, "o", "\u001b[2m# k8sgpt v0.4.36 \u2014 14 Go analyzers, no LLM involved\u001b[0m\r\n"]
[0.138121, "o", "\u001b[1;36m$ k8sgpt analyze --kubecontext mock-context --no-cache -n payment-prod\u001b[0m\r\n"]
[1.284949, "o", "AI Provider: \u001b[33mAI not used; --explain not set\u001b[0m\r\n\r\n\u001b[36m0\u001b[0m: \u001b[93mNode\u001b[0m \u001b[33mworker-3\u001b[0m(\u001b[36m\u001b[0m)\r\n- \u001b[31mError:\u001b[0m \u001b[31mworker-3 has condition of type DiskPressure, reason KubeletHasNoDiskSpace: kubelet has disk pressure\u001b[0m\r\n\u001b[32m\r\n\u001b[0m\u001b[36m1\u001b[0m: \u001b[93mPersistentVolumeClaim\u001b[0m \u001b[33mpayment-prod/payment-data-pvc\u001b[0m(\u001b[36m\u001b[0m)\r\n- \u001b[31mError:\u001b[0m \u001b[31mstorageclass.storage.k8s.io \"standard\" not found\u001b[0m\r\n\u001b[32m\r\n\u001b[0m\u001b[36m2\u001b[0m: \u001b[93mService\u001b[0m \u001b[33mpayment-prod/payment-api-svc\u001b[0m(\u001b[36m\u001b[0m)\r\n- \u001b[31mError:\u001b[0m \u001b[31mService has no endpoints, expected label app=payment-api-frontend\u001b[0m\r\n\u001b[32m\r\n\u001b[0m\u001b[36m3\u001b[0m: \u001b[93mIngress\u001b[0m \u001b[33mpayment-prod/payment-ingress\u001b[0m(\u001b[36m\u001b[0m)\r\n- \u001b[31mError:\u001b[0m \u001b[31mIngress uses the ingress class nginx which does not exist.\u001b[0m\r\n- \u001b[31mError:\u001b[0m \u001b[31mIngress uses the service payment-prod/payment-frontend which does not exist.\u001b[0m\r\n\u001b[32m\r\n\u001b[0m\u001b[36m4\u001b[0m: \u001b[93mPod\u001b[0m \u001b[33mpayment-prod/payment-api-7c4f5b-x9qkl\u001b[0m(\u001b[36mDeployment/payment-api\u001b[0m)\r\n- \u001b[31mError:\u001b[0m \u001b[31mthe last termination reason is Error container=api pod=payment-api-7c4f5b-x9qkl\u001b[0m\r\n\u001b[32m\r\n\u001b[0m\u001b[36m5\u001b[0m: \u001b[93mPod\u001b[0m \u001b[33mpayment-prod/payment-worker-6d8b2c-p3mnr\u001b[0m(\u001b[36mDeployment/payment-worker\u001b[0m)\r\n- \u001b[31mError:\u001b[0m \u001b[31mthe last termination reason is OOMKilled container=worker pod=payment-worker-6d8b2c-p3mnr\u001b[0m\r\n\u001b[32m\r\n\u001b[0m\u001b[36m6\u001b[0m: \u001b[93mDeployment\u001b[0m \u001b[33mpayment-prod/payment-api\u001b[0m(\u001b[36m\u001b[0m)\r\n- \u001b[31mError:\u001b[0m \u001b[31mDeployment payment-prod/payment-api has 1 replicas but 0 are available with status running\u001b[0m\r\n\u001b[32m\r\n\u001b[0m\u001b[36m7\u001b[0m: \u001b[93mDeployment\u001b[0m \u001b[33mpayment-prod/payment-worker\u001b[0m(\u001b[36m\u001b[0m)\r\n- \u001b[31mError:\u001b[0m \u001b[31mDeployment payment-prod/payment-worker has 1 replicas but 0 are available with status running\u001b[0m\r\n\u001b[32m\r\n\u001b[0m\r\n"]
[1.29092, "o", "\r\n"]
