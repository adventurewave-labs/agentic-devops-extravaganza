[1.185035, "o", "\r\n\u001b[2m# now fix them with real kubectl writes against the API\u001b[0m\r\n\u001b[1;36m$ ./scripts/remediate.sh\u001b[0m\r\n"]
[1.191791, "o", "\r\n\u001b[1;36m==> 1/7  payment-api CrashLoopBackOff -> roll to an image tag that exists\u001b[0m\r\n"]
