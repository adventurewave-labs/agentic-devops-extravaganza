[1.275246, "o", "\r\n\u001b[1;36m==> 2/7  payment-worker OOMKilled -> raise the memory limit above the working set\u001b[0m\r\n"]
[1.34484, "o", "deployment.apps/payment-worker patched\r\n"]
[1.347332, "o", "\r\n\u001b[1;36m==> 3/7  payment-api-svc has no endpoints -> correct the selector typo\u001b[0m\r\n"]
[1.434153, "o", "service/payment-api-svc patched\r\n"]
[1.437393, "o", "\r\n\u001b[1;36m==> 4/7  worker-3 DiskPressure -> cordon and drain the node\u001b[0m\r\n"]
[1.517439, "o", "node/worker-3 cordoned\r\n"]
[1.601915, "o", "node/worker-3 already cordoned\r\n"]
[1.610025, "o", "node/worker-3 drained\r\n"]
[1.61694, "o", "\r\n\u001b[1;36m==> 5/7  payment-ingress -> create the missing IngressClass\u001b[0m\r\n"]
[1.694703, "o", "ingressclass.networking.k8s.io/nginx created\r\n"]
[1.697601, "o", "\r\n\u001b[1;36m==> 6/7  payment-ingress -> create the missing backend Service\u001b[0m\r\n"]
