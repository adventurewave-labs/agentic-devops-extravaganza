[9.17, "o", "  \u001b[95m\u2502\u001b[0m ## \ud83d\udd25 Root Cause\r\n"]
[9.2, "o", "  \u001b[95m\u2502\u001b[0m The `payment-api` pod is in a `ContainersNotReady` state, likely due to a crash loop or failed startup, causing the high 5xx error rate.\r\n"]
[9.23, "o", "  \u001b[95m\u2502\u001b[0m ## Evidence\r\n"]
