[0.3, "o", "\u001b[96m\u001b[1m\u2551\u001b[95m  AGENTIC DEVOPS EXTRAVAGANZA \u2014 5 CHALLENGES IN 30s  \u001b[96m       \u2551\u001b[0m\r\n"]
