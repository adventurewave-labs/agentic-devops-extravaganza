[6.71, "o", "\r\n\u001b[1m\u001b[93m\u25b8 CHALLENGE 3: REMEDIATION\u001b[0m \u001b[2m\u2014 the kubectl commands that fix each issue\u001b[0m\r\n"]
[6.81, "o", "  \u001b[31mpayment-api\u001b[0m CrashLoopBackOff (bad image tag)\r\n"]
[6.86, "o", "  \u001b[2m$\u001b[0m \u001b[36mkubectl\u001b[0m set image deploy/payment-api api=registry.io/payments/api:1.4.3 -n payment-prod\r\n"]
[6.9, "o", "  \u001b[92m\u2713\u001b[0m rolling update started\r\n\r\n"]
[6.94, "o", "  \u001b[31mpayment-worker\u001b[0m OOMKilled (limit too low)\r\n"]
[6.99, "o", "  \u001b[2m$\u001b[0m \u001b[36mkubectl\u001b[0m patch deploy/payment-worker -n payment-prod --type=json -p '[{\"op\":\"replace\",\"path\":\"/spec/template/spec/containers/0/resources/limits/memory\",\"value\":\"512Mi\"}]'\r\n"]
[7.03, "o", "  \u001b[92m\u2713\u001b[0m memory limit raised 96Mi \u2192 512Mi\r\n\r\n"]
[7.07, "o", "  \u001b[31mpayment-ingress\u001b[0m dangling backend service\r\n"]
[7.12, "o", "  \u001b[2m$\u001b[0m \u001b[36mkubectl\u001b[0m create svc clusterip payment-frontend --tcp=80:8080 -n payment-prod\r\n"]
[7.16, "o", "  \u001b[92m\u2713\u001b[0m backing service created\r\n\r\n"]
[7.2, "o", "  \u001b[31mpayment-data-pvc\u001b[0m Pending (no StorageClass)\r\n"]
[7.25, "o", "  \u001b[2m$\u001b[0m \u001b[36mkubectl\u001b[0m create storageclass standard --provisioner=kubernetes.io/no-provisioner\r\n"]
[7.29, "o", "  \u001b[92m\u2713\u001b[0m StorageClass registered, PVC binding\r\n\r\n"]
[7.33, "o", "  \u001b[31mworker-3\u001b[0m DiskPressure\r\n"]
[7.38, "o", "  \u001b[2m$\u001b[0m \u001b[36mkubectl\u001b[0m drain worker-3 --ignore-daemonsets --delete-emptydir-data\r\n"]
[7.42, "o", "  \u001b[92m\u2713\u001b[0m node drained, kubelet will recover\r\n\r\n"]
[7.46, "o", "  \u001b[31mpayment-api-svc\u001b[0m selector mismatch\r\n"]
[7.51, "o", "  \u001b[2m$\u001b[0m \u001b[36mkubectl\u001b[0m patch svc payment-api-svc -n payment-prod -p '{\"spec\":{\"selector\":{\"app\":\"payment-api\"}}}'\r\n"]
[7.55, "o", "  \u001b[92m\u2713\u001b[0m selector fixed, endpoints populated\r\n\r\n"]
[7.79, "o", "\u001b[92m\u2713 6/6 issues remediated.\u001b[0m \u001b[2mCluster is converging.\u001b[0m\r\n"]
[8.09, "o", "\r\n\u001b[1m\u001b[93m\u25b8 CHALLENGE 4: AUTONOMOUS SRE\u001b[0m \u001b[2m\u2014 Robusta reacts to an alert with no human\u001b[0m\r\n"]
