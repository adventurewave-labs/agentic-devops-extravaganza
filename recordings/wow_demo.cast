[8.79, "o", "  \u001b[2m02\u001b[0m  Queried pod status        \u001b[2m\u2192\u001b[0m  payment-api-7c4f5b-x9qkl  \u001b[2m(CrashLoopBackOff)\u001b[0m\r\n"]
[8.85, "o", "  \u001b[2m03\u001b[0m  Queried deployment        \u001b[2m\u2192\u001b[0m  rev 3, 0/1 ready, deployed 28m ago\r\n"]
