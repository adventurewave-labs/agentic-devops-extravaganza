[15.1, "o", "\u001b[1m\u001b[93m\u25b6 CHALLENGE 3: REMEDIATION\u001b[0m \u001b[2m\u2014 the kubectl fixes\u001b[0m\r\n"]
[15.5, "o", "  \u001b[31mpayment-api\u001b[0m CrashLoopBackOff\r\n"]
[15.8, "o", "  \u001b[2m$\u001b[0m \u001b[36mkubectl\u001b[0m set image deploy/payment-api api=registry.io/payments/api:1.4.3\r\n"]
[16.1, "o", "  \u001b[92m\u2713\u001b[0m\r\n"]
[16.3, "o", "  \u001b[31mpayment-worker\u001b[0m OOMKilled\r\n"]
[16.6, "o", "  \u001b[2m$\u001b[0m \u001b[36mkubectl\u001b[0m patch deploy/payment-worker --type=json -p memory=512Mi\r\n"]
[16.9, "o", "  \u001b[92m\u2713\u001b[0m\r\n"]
[17.1, "o", "  \u001b[31mpayment-ingress\u001b[0m dangling backend\r\n"]
[17.4, "o", "  \u001b[2m$\u001b[0m \u001b[36mkubectl\u001b[0m create svc clusterip payment-frontend --tcp=80:8080\r\n"]
[17.7, "o", "  \u001b[92m\u2713\u001b[0m\r\n"]
[17.9, "o", "  \u001b[31mpayment-data-pvc\u001b[0m Pending\r\n"]
[18.2, "o", "  \u001b[2m$\u001b[0m \u001b[36mkubectl\u001b[0m create storageclass standard --provisioner=no-provisioner\r\n"]
[18.5, "o", "  \u001b[92m\u2713\u001b[0m\r\n"]
[18.7, "o", "  \u001b[31mworker-3\u001b[0m DiskPressure\r\n"]
[19.0, "o", "  \u001b[2m$\u001b[0m \u001b[36mkubectl\u001b[0m drain worker-3 --ignore-daemonsets --delete-emptydir-data\r\n"]
[19.3, "o", "  \u001b[92m\u2713\u001b[0m\r\n"]
[19.5, "o", "  \u001b[31mpayment-api-svc\u001b[0m selector mismatch\r\n"]
[19.8, "o", "  \u001b[2m$\u001b[0m \u001b[36mkubectl\u001b[0m patch svc payment-api-svc -p '{\"spec\":{\"selector\":{\"app\":\"payment-api\"}}}'\r\n"]
[20.1, "o", "  \u001b[92m\u2713\u001b[0m\r\n"]
[20.5, "o", "\r\n\u001b[92m\u2713 6/6 issues remediated.\u001b[0m\r\n\r\n"]
[21.0, "o", "\u001b[1m\u001b[93m\u25b6 CHALLENGE 4: AUTONOMOUS SRE\u001b[0m \u001b[2m\u2014 Robusta, no human in loop\u001b[0m\r\n"]
[21.4, "o", "\u001b[96m$ robusta run --alert payment-api-high-error-rate.json\u001b[0m\r\n"]
